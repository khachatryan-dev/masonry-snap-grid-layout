{
  "name": "masonry-snap-grid-layout",
  "version": "1.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "src/core",
    "src/vanilla",
    "src/angular"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./angular": {
      "types": "./src/angular/index.ts",
      "default": "./src/angular/index.ts"
    },
    "./style.css": "./dist/style.css",
    "./dist/index.css": "./dist/style.css"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "description": "Masonry grid layout for React, Vue 3, Angular, and Vanilla JS. Pinterest-style responsive image gallery with scroll virtualization, SSR support for Next.js and Nuxt, automatic relayout on image load, and responsive column breakpoints. Zero dependencies, TypeScript-first.",
  "homepage": "https://github.com/khachatryan-dev/masonry-snap-grid-layout#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/khachatryan-dev/masonry-snap-grid-layout.git"
  },
  "bugs": {
    "url": "https://github.com/khachatryan-dev/masonry-snap-grid-layout/issues"
  },
  "author": "Aram Khachatryan <arkhachats@gmail.com> (https://github.com/khachatryan-dev)",
  "license": "MIT",
  "keywords": [
    "masonry",
    "masonry-layout",
    "masonry-grid",
    "grid-layout",
    "pinterest-layout",
    "waterfall-layout",
    "responsive-grid",
    "image-gallery",
    "photo-gallery",
    "react-masonry",
    "react-masonry-layout",
    "vue-masonry",
    "vue-masonry-layout",
    "angular-masonry",
    "vanilla-masonry",
    "nextjs-masonry",
    "nuxt-masonry",
    "virtualization",
    "scroll-virtualization",
    "virtual-scroll",
    "infinite-scroll",
    "css-masonry",
    "css-grid",
    "responsive-columns",
    "breakpoints",
    "resize-observer",
    "lazy-loading",
    "ssr",
    "server-side-rendering",
    "nextjs",
    "nuxt",
    "typescript",
    "zero-dependencies",
    "layout",
    "ui-component",
    "masonry-snap-grid-layout"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "dev": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.angular.json && vue-tsc --noEmit -p tsconfig.vue.json && vue-tsc --noEmit -p tsconfig.examples.json",
    "typecheck:core": "tsc --noEmit",
    "typecheck:angular": "tsc --noEmit -p tsconfig.angular.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "verify": "npm run lint && npm run format:check && npm run check:arch && npm run typecheck && npm test && npm run build && npm run size && npm run check:package",
    "prepublishOnly": "npm run verify",
    "check:package": "node scripts/check-package.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "typecheck:examples": "vue-tsc --noEmit -p tsconfig.examples.json"
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.9.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12",
    "zone.js": "^0.14.10"
  }
}
